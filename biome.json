{
  "$schema": "https://biomejs.dev/schemas/2.5.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!reference", "!dist", "!**/*.css"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 90
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "src/lib/potrace/**",
        "src/worker/trace.worker.ts",
        "tests/potrace.test.ts"
      ],
      "formatter": { "enabled": false },
      "linter": {
        "rules": {
          "style": { "useTemplate": "off", "useExponentiationOperator": "off" },
          "suspicious": { "noAssignInExpressions": "off" }
        }
      }
    }
  ]
}
